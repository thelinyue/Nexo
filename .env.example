# Server 对外提供给 Agent 的 Tunnel 地址；必须能从 Agent 所在网络访问。
NEXO_TUNNEL_ENDPOINT=nexo.example.com:9891

# 正式组网入口。配置公网域名后应使用 https://mesh.<根域名>。
NEXO_MESH_ENDPOINT=https://mesh.example.com
NEXO_MESH_DNS_BASE_DOMAIN=mesh.nexo.internal

# 独立 Agent 指向任意 Nexo Server。首次入网时临时填写 Token，成功后删除。
NEXO_SERVER_URL=http://nexo.example.com:8280
NEXO_CONTROL_ADDR=nexo.example.com:9890
NEXO_CONTROL_SERVER_NAME=nexo-server
NEXO_AGENT_TUNNEL_ADDR=nexo.example.com:9891
NEXO_TUNNEL_SERVER_NAME=nexo-server
NEXO_ENROLLMENT_TOKEN=
NEXO_DEVICE_NAME=Nexo Gateway
NEXO_AGENT_CAPABILITIES=mesh,subnet_gateway,site_gateway,tunnel
