# Nexo Server 镜像：Rust API/Web/Tunnel + Caddy 公网入口。
FROM node:26.13.1-alpine@sha256:6bd9ab43c0ec0190ca7b2d193906cb8b7edf6e7f4afa43ddeccd6452710bffb5 AS web-build
WORKDIR /src/web
COPY web/package.json web/package-lock.json ./
RUN npm ci --ignore-scripts
COPY web/ ./
COPY compose.agent.yml /src/compose.agent.yml
RUN npm run build

FROM rust:1.100.0-bookworm@sha256:ade39a710ef85f3506cffcfec3e8a24ba090badef1dff2fb798f71d878833fea AS rust-build
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY release-manifest.json ./
COPY crates ./crates
COPY config ./config
COPY migrations ./migrations
COPY docker/install-node.sh ./docker/install-node.sh
COPY web/src/data/hd-icons.json ./web/src/data/hd-icons.json
COPY --from=web-build /src/web/dist ./web/dist
RUN cargo build --release --locked -p nexo-server

FROM golang:1.27.4-bookworm@sha256:4fa7c968ba93f1635670522dbb01a2c78150443e1385746924566079f36570ea AS caddy-base
ARG CADDY_VERSION=2.11.9
ARG XCADDY_VERSION=0.4.7
ENV CGO_ENABLED=0
RUN go install "github.com/caddyserver/xcaddy/cmd/xcaddy@v${XCADDY_VERSION}"

FROM caddy-base AS caddy-node-build
# 节点加载 Server 下发的证书，标准模块足以提供节点的 HTTP/HTTPS 入口。
RUN /go/bin/xcaddy build "v${CADDY_VERSION}" --output /usr/local/bin/caddy \
    && /usr/local/bin/caddy version | grep -Fq "v${CADDY_VERSION}"

# 本地导出只复制 Caddy，省去构建和提取包含 Go 工具链的镜像。
FROM scratch AS caddy-node
COPY --from=caddy-node-build /usr/local/bin/caddy /caddy

FROM caddy-base AS caddy-build
ARG CLOUDFLARE_MODULE_VERSION=0.2.4
RUN /go/bin/xcaddy build "v${CADDY_VERSION}" \
      --with "github.com/caddy-dns/cloudflare@v${CLOUDFLARE_MODULE_VERSION}" \
      --with "github.com/caddy-dns/alidns@v1.0.29" \
      --with "github.com/caddy-dns/tencentcloud@v0.4.3" \
      --output /usr/local/bin/caddy \
    && /usr/local/bin/caddy version | grep -q "v${CADDY_VERSION}" \
    && /usr/local/bin/caddy list-modules | grep -q "dns.providers.cloudflare"

FROM debian:bookworm-slim@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc
ARG NEXO_VERSION=0.2.13
ARG NEXO_REVISION=unknown
ARG TARGETARCH=amd64
ARG CADDY_VERSION=2.11.9
ARG XCADDY_VERSION=0.4.7
ARG CLOUDFLARE_MODULE_VERSION=0.2.4
RUN apt-get update \
    && apt-get install --no-install-recommends -y ca-certificates curl tzdata \
    && rm -rf /var/lib/apt/lists/*
COPY --from=rust-build /src/target/release/nexo-server /usr/local/bin/nexo-server
COPY --from=caddy-build /usr/local/bin/caddy /usr/local/bin/caddy
COPY --from=web-build /src/web/dist /usr/local/bin/web
COPY LICENSE THIRD_PARTY_NOTICES.md /usr/share/doc/nexo/
COPY licenses /usr/share/doc/nexo/licenses
RUN ln -s /usr/local/bin/nexo-server /usr/local/bin/nexo
LABEL org.opencontainers.image.title="Nexo Server" \
      org.opencontainers.image.description="Nexo 联巢自托管内网穿透服务端与公网入口" \
      org.opencontainers.image.source="https://github.com/thelinyue/Nexo" \
      org.opencontainers.image.version="${NEXO_VERSION}" \
      org.opencontainers.image.revision="${NEXO_REVISION}" \
      org.opencontainers.image.licenses="AGPL-3.0-only"
ENV TZ=Asia/Shanghai
VOLUME ["/data/nexo"]
EXPOSE 80 443 443/udp 8280 9890 9891 9891/udp 20000-29999 20000-29999/udp
HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=6 \
  CMD curl --fail --silent http://127.0.0.1:8280/health >/dev/null || exit 1
ENTRYPOINT ["/usr/local/bin/nexo-server", "--data-dir", "/data/nexo"]
