# Nexo Server 镜像：Rust API/Web/Tunnel + Caddy 公网入口。
FROM node:22.16.0-alpine@sha256:41e4389f3d988d2ed55392df4db1420ad048ae53324a8e2b7c6d19508288107e AS web-build
WORKDIR /src/web
COPY web/package.json web/package-lock.json ./
RUN npm ci --ignore-scripts
COPY web/ ./
COPY compose.agent.yml /src/compose.agent.yml
RUN npm run build

FROM rust:1.89-bookworm@sha256:948f9b08a66e7fe01b03a98ef1c7568292e07ec2e4fe90d88c07bb14563c84ff AS rust-build
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY migrations ./migrations
COPY --from=web-build /src/web/dist ./web/dist
RUN cargo build --release -p nexo-server

FROM golang:1.27.1-bookworm@sha256:69a7b9788769bec032d238959b61854e9ae87f57be9029ec04e9885fabf99195 AS caddy-build
ARG CADDY_VERSION=2.11.4
ARG XCADDY_VERSION=0.4.7
ARG CLOUDFLARE_MODULE_VERSION=0.2.4
RUN go install "github.com/caddyserver/xcaddy/cmd/xcaddy@v${XCADDY_VERSION}" \
    && /go/bin/xcaddy build "v${CADDY_VERSION}" \
      --with "github.com/caddy-dns/cloudflare@v${CLOUDFLARE_MODULE_VERSION}" \
      --output /usr/local/bin/caddy \
    && /usr/local/bin/caddy version | grep -q "v${CADDY_VERSION}" \
    && /usr/local/bin/caddy list-modules | grep -q "dns.providers.cloudflare"

FROM debian:bookworm-slim@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171
ARG NEXO_VERSION=0.2.1
ARG NEXO_REVISION=unknown
ARG TARGETARCH=amd64
ARG CADDY_VERSION=2.11.4
ARG XCADDY_VERSION=0.4.7
ARG CLOUDFLARE_MODULE_VERSION=0.2.4
RUN apt-get update \
    && apt-get install --no-install-recommends -y ca-certificates curl tzdata \
    && rm -rf /var/lib/apt/lists/*
COPY --from=rust-build /src/target/release/nexo-server /usr/local/bin/nexo-server
COPY --from=caddy-build /usr/local/bin/caddy /usr/local/bin/caddy
COPY --from=web-build /src/web/dist /opt/nexo/web
COPY LICENSE THIRD_PARTY_NOTICES.md /usr/share/doc/nexo/
COPY licenses /usr/share/doc/nexo/licenses
RUN ln -s /usr/local/bin/nexo-server /usr/local/bin/nexo
LABEL org.opencontainers.image.title="Nexo Server" \
      org.opencontainers.image.description="Nexo 联巢自托管内网穿透服务端与公网入口" \
      org.opencontainers.image.source="https://github.com/thelinyue/Nexo" \
      org.opencontainers.image.version="${NEXO_VERSION}" \
      org.opencontainers.image.revision="${NEXO_REVISION}" \
      org.opencontainers.image.licenses="AGPL-3.0-only"
ENV TZ=Asia/Shanghai \
    NEXO_DATA_DIR=/data/nexo \
    NEXO_WEB_DIR=/opt/nexo/web \
    NEXO_HTTP_ADDR=0.0.0.0:8280 \
    NEXO_CONTROL_ADDR=0.0.0.0:9890 \
    NEXO_CADDY_BIN=/usr/local/bin/caddy \
    NEXO_CADDY_ENABLED=true \
    NEXO_TUNNEL_ADDR=0.0.0.0:9891
VOLUME ["/data/nexo"]
EXPOSE 80 443 443/udp 8280 9890 9891 20000-29999
HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=6 \
  CMD curl --fail --silent http://127.0.0.1:8280/health >/dev/null || exit 1
ENTRYPOINT ["/usr/local/bin/nexo-server"]
