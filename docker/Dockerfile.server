# Nexo 第二阶段 Server 镜像：Rust API/Web/Tunnel + Caddy + 独立 Headscale 子进程。
# Caddy、Headscale 和 Nexo 以独立子进程集成；公网入口由 Caddy 管理。
FROM node:22.16.0-alpine@sha256:41e4389f3d988d2ed55392df4db1420ad048ae53324a8e2b7c6d19508288107e AS web-build
WORKDIR /src/web
COPY web/package.json web/package-lock.json ./
RUN npm ci --ignore-scripts
COPY web/ ./
RUN npm run build

FROM rust:1.89-bookworm@sha256:948f9b08a66e7fe01b03a98ef1c7568292e07ec2e4fe90d88c07bb14563c84ff AS rust-build
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY migrations ./migrations
COPY --from=web-build /src/web/dist ./web/dist
RUN cargo build --release -p nexo-server

FROM golang:1.25.1-bookworm@sha256:c423747fbd96fd8f0b1102d947f51f9b266060217478e5f9bf86f145969562ee AS caddy-build
ARG CADDY_VERSION=2.11.4
ARG XCADDY_VERSION=0.4.7
ARG CLOUDFLARE_MODULE_VERSION=0.2.4
RUN go install "github.com/caddyserver/xcaddy/cmd/xcaddy@v${XCADDY_VERSION}" \
    && /go/bin/xcaddy build "v${CADDY_VERSION}" \
      --with "github.com/caddy-dns/cloudflare@v${CLOUDFLARE_MODULE_VERSION}" \
      --output /usr/local/bin/caddy \
    && /usr/local/bin/caddy version | grep -q "v${CADDY_VERSION}" \
    && /usr/local/bin/caddy list-modules | grep -q "dns.providers.cloudflare"

FROM debian:bookworm-slim@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171
ARG NEXO_VERSION=0.1.6
ARG NEXO_REVISION=unknown
ARG TARGETARCH=amd64
ARG HEADSCALE_VERSION=0.29.3
ARG CADDY_VERSION=2.11.4
ARG XCADDY_VERSION=0.4.7
ARG CLOUDFLARE_MODULE_VERSION=0.2.4
ARG HEADSCALE_AMD64_SHA256=8dc183758024ed7095cf610fedea0790233613c71353bc8be2715d82ba29b92c
ARG HEADSCALE_ARM64_SHA256=ecf0099f9aa1efb56e7c74718342a493f7d44a840626a2877ca526e675040f4e
RUN apt-get update \
    && apt-get install --no-install-recommends -y ca-certificates curl tzdata \
    && rm -rf /var/lib/apt/lists/* \
    && case "$TARGETARCH" in \
         amd64) HS_ARCH=amd64; HS_SHA="$HEADSCALE_AMD64_SHA256" ;; \
         arm64) HS_ARCH=arm64; HS_SHA="$HEADSCALE_ARM64_SHA256" ;; \
         *) echo "不支持的目标架构：$TARGETARCH" >&2; exit 1 ;; \
       esac \
    && curl --fail --location --silent --show-error \
         "https://github.com/juanfont/headscale/releases/download/v${HEADSCALE_VERSION}/headscale_${HEADSCALE_VERSION}_linux_${HS_ARCH}" \
         --output /usr/local/bin/headscale \
    && echo "$HS_SHA  /usr/local/bin/headscale" | sha256sum --check --status \
    && chmod 0755 /usr/local/bin/headscale
COPY --from=rust-build /src/target/release/nexo-server /usr/local/bin/nexo-server
COPY --from=caddy-build /usr/local/bin/caddy /usr/local/bin/caddy
COPY --from=web-build /src/web/dist /opt/nexo/web
COPY LICENSE THIRD_PARTY_NOTICES.md /usr/share/doc/nexo/
COPY licenses /usr/share/doc/nexo/licenses
RUN ln -s /usr/local/bin/nexo-server /usr/local/bin/nexo
LABEL org.opencontainers.image.title="Nexo Server" \
      org.opencontainers.image.description="Nexo 联巢服务端、Web、公网入口与组网控制服务" \
      org.opencontainers.image.source="https://github.com/thelinyue/Nexo" \
      org.opencontainers.image.version="${NEXO_VERSION}" \
      org.opencontainers.image.revision="${NEXO_REVISION}" \
      org.opencontainers.image.licenses="AGPL-3.0-only"
ENV TZ=Asia/Shanghai \
    NEXO_HEADSCALE_ENABLED=true \
    NEXO_HEADSCALE_BIN=/usr/local/bin/headscale \
    NEXO_HEADSCALE_VERSION=0.29.3 \
    NEXO_DATA_DIR=/data/nexo \
    NEXO_WEB_DIR=/opt/nexo/web \
    NEXO_HTTP_ADDR=0.0.0.0:8280 \
    NEXO_CONTROL_ADDR=0.0.0.0:9890 \
    NEXO_HEADSCALE_LISTEN_ADDR=127.0.0.1:8281 \
    NEXO_HEADSCALE_API_URL=http://127.0.0.1:8281 \
    NEXO_HEADSCALE_URL=https://mesh.example.com \
    NEXO_CADDY_ENABLED=true \
    NEXO_CADDY_BIN=/usr/local/bin/caddy \
    NEXO_CADDY_ADMIN_URL=http://127.0.0.1:8290 \
    NEXO_PUBLIC_BACKEND_ADDR=127.0.0.1:9888 \
    NEXO_TUNNEL_ADDR=0.0.0.0:9891
VOLUME ["/data/nexo"]
EXPOSE 80 443 8280 9890 9891 20000-29999
HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=6 \
  CMD curl --fail --silent http://127.0.0.1:8280/health >/dev/null || exit 1
ENTRYPOINT ["/usr/local/bin/nexo-server"]
