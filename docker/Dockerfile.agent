# Nexo Agent 镜像。Tailscale 二进制保持独立文件，不编译进 nexo-agent。
FROM ghcr.io/tailscale/tailscale:v1.102.3@sha256:8c42c4574ab066384fcb72f69e086a2ff1dd3652eb6f56856cee34bcf0d2f680 AS tailscale

FROM rust:1.89-bookworm AS rust-build
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY migrations ./migrations
RUN cargo build --release -p nexo-agent

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install --no-install-recommends -y ca-certificates iproute2 iptables \
    && rm -rf /var/lib/apt/lists/*
COPY --from=rust-build /src/target/release/nexo-agent /usr/local/bin/nexo-agent
COPY --from=tailscale /usr/local/bin/tailscale /usr/local/bin/tailscale
COPY --from=tailscale /usr/local/bin/tailscaled /usr/local/bin/tailscaled
ENV NEXO_STATE_DIR=/data/nexo-agent \
    NEXO_TAILSCALE_BIN=/usr/local/bin/tailscale \
    NEXO_TAILSCALED_BIN=/usr/local/bin/tailscaled \
    NEXO_TAILSCALE_APPLY=true \
    NEXO_TAILSCALED_ENABLED=true
VOLUME ["/data/nexo-agent"]
ENTRYPOINT ["/usr/local/bin/nexo-agent"]
