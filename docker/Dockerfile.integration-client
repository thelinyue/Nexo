# 仅用于验收的官方 Tailscale 客户端，不运行 Nexo Agent。
FROM ghcr.io/tailscale/tailscale:v1.102.3@sha256:8c42c4574ab066384fcb72f69e086a2ff1dd3652eb6f56856cee34bcf0d2f680 AS tailscale
FROM debian:bookworm-slim
RUN apt-get update && apt-get install --no-install-recommends -y ca-certificates curl iproute2 iptables && rm -rf /var/lib/apt/lists/*
COPY --from=tailscale /usr/local/bin/tailscale /usr/local/bin/tailscale
COPY --from=tailscale /usr/local/bin/tailscaled /usr/local/bin/tailscaled
ENTRYPOINT ["/bin/sh", "-c"]
# 禁止测试宿主机 Docker bridge 代替 Tailscale 转发，确保关闭子网后不会绕路。
CMD ["cp /run/nexo-phase2-certs/mesh-ca.crt /usr/local/share/ca-certificates/nexo-test.crt && update-ca-certificates >/dev/null && iptables -A OUTPUT -o eth0 -d 192.168.10.0/24 -j REJECT && iptables -A OUTPUT -o eth0 -d 192.168.20.0/24 -j REJECT && exec tailscaled --state=/tmp/tailscaled.state --statedir=/tmp/tailscale"]
